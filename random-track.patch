+  for (let hi = 0; hi < def.handles.length; hi++) {
+    if (!def.handles[hi].gap) continue;
+    const s = track.handleS[hi];
+    if (!jumpOkWithAI(track, s) || !jumpOkWithBot(track, s)) return false;
+  }
+  return true;
+}
 
